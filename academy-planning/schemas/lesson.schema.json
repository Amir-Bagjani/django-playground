{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-playground.local/schemas/lesson.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title_fa",
    "locale",
    "version",
    "status",
    "objectives",
    "exercise_ids",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DB-[0-9]{2}-[0-9]{3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title_fa": {
      "type": "string",
      "minLength": 8
    },
    "locale": {
      "const": "fa-IR"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "in-review",
        "approved"
      ]
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 12
      }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^DB-[0-9]{2}-[0-9]{3}$"
      }
    },
    "exercise_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 3
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 180
    }
  }
}
